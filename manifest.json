{
  "manifest_version": 3,
  "name": "Headroom",
  "version": "1.4.2",
  "description": "See your AI usage limit as a thin bar on the chat sites you use, with the live weather as a sky behind the chat.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://www.kimi.com/*",
    "https://kimi.com/*",
    "https://chat.deepseek.com/*",
    "https://chat.qwen.ai/*",
    "https://chat.mistral.ai/*",
    "https://copilot.microsoft.com/*",
    "https://copilot.com/*",
    "https://www.copilot.com/*",
    "https://www.meta.ai/*",
    "https://meta.ai/*",
    "https://poe.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Headroom",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://www.kimi.com/*",
        "https://kimi.com/*",
        "https://chat.deepseek.com/*",
        "https://chat.qwen.ai/*",
        "https://chat.mistral.ai/*",
        "https://copilot.microsoft.com/*",
        "https://copilot.com/*",
        "https://www.copilot.com/*",
        "https://www.meta.ai/*",
        "https://meta.ai/*",
        "https://poe.com/*"
      ],
      "js": [
        "src/inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://www.kimi.com/*",
        "https://kimi.com/*",
        "https://chat.deepseek.com/*",
        "https://chat.qwen.ai/*",
        "https://chat.mistral.ai/*",
        "https://copilot.microsoft.com/*",
        "https://copilot.com/*",
        "https://www.copilot.com/*",
        "https://www.meta.ai/*",
        "https://meta.ai/*",
        "https://poe.com/*"
      ],
      "js": [
        "src/core/quotas.js",
        "src/core/common.js",
        "src/core/parsers.js",
        "src/core/store.js",
        "src/core/banner.js",
        "src/core/weather-data.js",
        "src/core/widget.js",
        "src/core/chatdom.js",
        "src/adapters/claude.js",
        "src/adapters/chatgpt.js",
        "src/adapters/gemini.js",
        "src/adapters/grok.js",
        "src/adapters/perplexity.js",
        "src/adapters/kimi.js",
        "src/adapters/generic.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "optional_permissions": [
    "geolocation"
  ]
}
